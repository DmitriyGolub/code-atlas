{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/code-atlas/schema/code-atlas.schema.json",
  "title": "ECS Code Map",
  "description": "A map of an ECS codebase built from the TypeScript AST and type checker. What OpenAPI is for HTTP, this is for systems, components and the data flow of a frame. Generated by code-atlas; do not edit by hand.",
  "type": "object",
  "required": ["codeAtlas", "sourceDigest", "frame", "systems", "units", "edges", "findings", "tests", "impacts"],
  "$defs": {
    "location": {
      "type": "object",
      "required": ["file", "line"],
      "properties": { "file": { "type": "string", "description": "Path relative to the project root" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "access": {
      "type": "object",
      "description": "One read, write, tag, event, port or call at an exact place in the code",
      "required": ["value", "file", "line"],
      "properties": {
        "value": { "type": "string", "description": "Component.field, tag, event name, port member or symbol id" },
        "file": { "type": "string" }, "line": { "type": "integer" },
        "via": { "type": "string", "description": "Id of the symbol where the access happens: the system itself or a rule it calls" },
        "excluded": { "type": "boolean" }
      }
    },
    "accesses": { "type": "array", "items": { "$ref": "#/$defs/access" } },
    "link": {
      "type": "object", "required": ["unit", "name", "file", "line"],
      "properties": { "unit": { "type": "string" }, "name": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "codeAtlas": { "const": "1.0", "description": "Format version" },
    "sourceDigest": { "type": "string", "description": "Hash of the source and test files. When it differs from the code, the map is stale" },
    "frame": { "type": "array", "items": { "type": "string" }, "description": "Systems in execution order: simulation first, then view" },
    "fresh": { "type": "array", "items": { "type": "string" }, "description": "Systems added since the --since ref" },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "file", "line", "domain", "position", "phase", "mode", "queries", "reads", "writes", "adds", "removes", "eventReads", "eventWrites", "ports", "rules", "creates"],
        "properties": {
          "id": { "type": "string", "description": "file#name" }, "name": { "type": "string" }, "kind": { "const": "system" },
          "file": { "type": "string" }, "line": { "type": "integer" },
          "planned": { "type": "boolean", "description": "Stub: data comes from // criteria, not code" },
          "domain": { "type": "string", "description": "Folder inside the systems layer" },
          "position": { "type": "integer", "minimum": 0, "description": "Step in the frame, 0 when the system is not in the pipeline" },
          "phase": { "enum": ["simulation", "view"] },
          "mode": { "type": "string", "description": "'all', or the pipeline modes the system belongs to" },
          "queries": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "terms": { "type": "array", "items": { "type": "string" } }, "file": { "type": "string" }, "line": { "type": "integer" } } } },
          "reads": { "$ref": "#/$defs/accesses" }, "writes": { "$ref": "#/$defs/accesses" },
          "adds": { "$ref": "#/$defs/accesses" }, "removes": { "$ref": "#/$defs/accesses" },
          "eventReads": { "$ref": "#/$defs/accesses" }, "eventWrites": { "$ref": "#/$defs/accesses" },
          "ports": { "$ref": "#/$defs/accesses" }, "rules": { "$ref": "#/$defs/accesses" }, "creates": { "$ref": "#/$defs/accesses" }
        }
      }
    },
    "units": {
      "type": "array",
      "description": "Every top-level symbol: systems, rules, entities, components, queries",
      "items": {
        "type": "object", "required": ["id", "name", "kind", "file", "line", "callers", "calls"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "kind": { "enum": ["system", "rule", "entity", "component", "query", "config", "outside", "method"] },
          "file": { "type": "string" }, "line": { "type": "integer" }, "planned": { "type": "boolean" },
          "lines": { "type": "integer", "description": "Length of the declaration in lines" },
          "complexity": { "type": "integer", "description": "1 plus the number of branches and logical operators" },
          "exported": { "type": "boolean" },
          "decorators": { "type": "array", "items": { "type": "string" }, "description": "Decorator names on a class or method, such as Controller or Injectable" },
          "owner": { "type": "string", "description": "Id of the class a method belongs to" },
          "doc": { "type": "string", "description": "JSDoc text above the declaration, tags removed" },
          "callers": { "type": "array", "items": { "$ref": "#/$defs/link" } },
          "calls": { "type": "array", "items": { "$ref": "#/$defs/link" } }
        }
      }
    },
    "edges": {
      "type": "array", "description": "Data flow between systems",
      "items": {
        "type": "object", "required": ["from", "to", "via", "kind", "hub", "nextFrame"],
        "properties": {
          "from": { "type": "string" }, "to": { "type": "string" },
          "via": { "type": "string", "description": "component:Name or event:name" },
          "kind": { "enum": ["field", "tag", "event"] },
          "hub": { "type": "boolean", "description": "The component has more readers than findings.hubReaders; hidden on the diagram" },
          "nextFrame": { "type": "boolean", "description": "The reader runs before the writer and sees the change one frame later" },
          "excluded": { "type": "boolean", "description": "The reader only excludes this component in a query (Not), it does not read its data" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["kind", "system", "file", "line", "text"],
        "properties": { "kind": { "enum": ["next-frame", "wide", "write-only"] }, "system": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" }, "text": { "type": "string" } }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "file", "line", "symbols", "simulates"],
        "properties": { "title": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" }, "symbols": { "type": "array", "items": { "type": "string" } }, "simulates": { "type": "boolean" } }
      }
    },
    "impacts": {
      "type": "object", "description": "What changing each symbol affects, keyed by symbol id",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "executing": { "type": "array", "items": { "type": "string" }, "description": "Frame systems that run this code" },
          "readers": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "through": { "type": "array", "items": { "type": "string" } } } } },
          "writers": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "accesses": { "$ref": "#/$defs/accesses" } } } },
          "contracts": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } } } },
          "writesFields": { "type": "array", "items": { "type": "string" } }, "writesTags": { "type": "array", "items": { "type": "string" } }, "emits": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "object", "properties": { "title": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } } } },
          "simulationTests": { "type": "integer" }, "transitive": { "type": "integer" }
        }
      }
    }
  }
}
